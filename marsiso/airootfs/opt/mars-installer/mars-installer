#!/usr/bin/env bash

##################################################
# Mars OS Installer v1.1
# Main Launcher
##################################################

set -e


##################################################
# Error Handling
##################################################

trap 'die "Installer failed at line $LINENO"' ERR



##################################################
# Paths
##################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

LIB_DIR="$SCRIPT_DIR/lib"
WIZARD_DIR="$SCRIPT_DIR/wizard"
INSTALL_DIR="$SCRIPT_DIR/install"



##################################################
# Libraries
##################################################

source "$LIB_DIR/util.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/ui.sh"



##################################################
# Requirements
##################################################

check_requirements() {

    require_command dialog
    require_command pacman
    require_command arch-chroot

}



##################################################
# Wizard Runner
##################################################

run_wizard() {
    local modules=("$WIZARD_DIR"/*.sh)
    local index=0
    local status
    local module

    while (( index < ${#modules[@]} )); do
        module="${modules[$index]}"
        log "Running wizard module: $module"

        if bash "$module"; then
            index=$((index + 1))
            continue
        else
            status=$?
        fi

        case "$status" in
            3)
                if (( index == 0 )); then
                    log "Wizard canceled at the first page."
                    return 1
                fi
                index=$((index - 1))
                ;;
            1|130|143|255)
                log "Wizard canceled by user."
                return 1
                ;;
            *)
                die "Wizard failed on page: $module (exit code $status)"
                ;;
        esac
    done


}



##################################################
# Install Runner
##################################################

run_install() {


    for MODULE in "$INSTALL_DIR"/*.sh; do


        if [[ -f "$MODULE" ]]; then


            log "Running install module: $MODULE"



            bash "$MODULE" || die \
"\
Installation failed:

$MODULE
"



        fi


    done


}



##################################################
# Main
##################################################

main() {


    check_requirements



    config_init

    config_clear



    log "Mars OS Installer v1.1 started"



    if ! run_wizard; then
        log "Installation canceled before any changes were made."
        return 0
    fi


    run_install



    ui_msgbox \
        "Complete" \
"\
Mars OS installation finished.

You may now reboot into your new system.
"



}



main
